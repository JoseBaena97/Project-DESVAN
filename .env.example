# Copia este archivo como .env y rellena los valores.
# Backend: os.getenv("VARIABLE") · Frontend: import.meta.env.VARIABLE (solo las que empiezan por VITE_)

# ── Backend ────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:password@localhost:5432/eldesvan
FLASK_APP=src/app.py
FLASK_DEBUG=1
FLASK_APP_KEY=cambia-esta-clave
JWT_SECRET_KEY=cambia-esta-clave-jwt

# Envío de emails (recuperación de contraseña)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@el-desvan.com
FLASK_MAIL_SUPPRESS_SEND=false

# Subida de imágenes
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend ───────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:3001/
VITE_GOOGLE_MAPS_API_KEY=
